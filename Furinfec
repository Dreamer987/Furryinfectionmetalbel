-- ================== HIT INSTINCT (Chỉ spam Tool đang cầm) ==================
local HitInstinctEnabled = false
local HitConnection = nil

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")

local function EnableHitInstinct()
    HitInstinctEnabled = true
    
    HitConnection = RunService.Heartbeat:Connect(function()
        if not HitInstinctEnabled then return end
        
        local char = LocalPlayer.Character
        if not char then return end
        
        local tool = char:FindFirstChildOfClass("Tool")
        if not tool then return end   -- Chỉ hoạt động khi đang cầm Tool
        
        local myRoot = char:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end
        
        local myTeam = LocalPlayer.Team
        local shouldHit = false
        
        -- Kiểm tra có người khác team trong 13 studs không
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local theirRoot = plr.Character:FindFirstChild("HumanoidRootPart")
                if theirRoot then
                    local distance = (myRoot.Position - theirRoot.Position).Magnitude
                    
                    local sameTeam = (myTeam and plr.Team == myTeam)
                    
                    if distance < 10 and not sameTeam then
                        shouldHit = true
                        break
                    end
                end
            end
        end
        
        -- Nếu có người gần → spam Activate Tool
        if shouldHit then
            tool:Activate()
            -- task.wait(2.12)   -- Bạn có thể mở comment và chỉnh số này nếu muốn hit chậm hơn
        end
    end)
    
    OrionLib:MakeNotification({
        Name = "Hit Instinct",
        Content = "Đã bật Hit Instinct!\nCầm tool gì cũng sẽ tự động spam hit khi có người khác team trong 13 studs.",
        Image = "rbxassetid://4483345998",
        Time = 4
    })
end

local function DisableHitInstinct()
    HitInstinctEnabled = false
    if HitConnection then
        HitConnection:Disconnect()
        HitConnection = nil
    end
    
    OrionLib:MakeNotification({
        Name = "Hit Instinct",
        Content = "Đã tắt Hit Instinct.",
        Image = "rbxassetid://4483345998",
        Time = 3
    })
end

