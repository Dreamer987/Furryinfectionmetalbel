local ESPConnection = nil
local Highlights = {}
local ESPParts = {}   -- Lưu các khối Part tạo thêm

local function CreateESPForEgg(egg)
    if not egg or not egg:IsA("MeshPart") then return end
    if egg:FindFirstChild("EggESP") then return end   -- Tránh tạo lặp
    
    -- 1. Tạo Highlight trực tiếp trên MeshPart (xanh dương sáng)
    local highlight = Instance.new("Highlight")
    highlight.Name = "EggESP"
    highlight.FillColor = Color3.fromRGB(0, 255, 255)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 0)
    highlight.FillTransparency = 0.3
    highlight.OutlineTransparency = 0
    highlight.Adornee = egg          -- Quan trọng: set trực tiếp MeshPart
    highlight.Parent = egg
    
    table.insert(Highlights, highlight)
    
    -- 2. Tạo khối Part nhỏ gần trứng (dễ nhìn hơn, có thể xuyên tường)
    local espPart = Instance.new("Part")
    espPart.Name = "EggESPBlock"
    espPart.Size = Vector3.new(4, 4, 4)           -- Kích thước khối (có thể chỉnh nhỏ hơn)
    espPart.Color = Color3.fromRGB(0, 255, 255)
    espPart.Transparency = 0.4
    espPart.Anchored = true
    espPart.CanCollide = false
    espPart.CanTouch = false
    espPart.Material = Enum.Material.Neon
    espPart.Position = egg.Position + Vector3.new(0, 5, 0)   -- Ở trên trứng 5 studs
    espPart.Parent = workspace
    
    -- Weld để Part luôn theo trứng (khi trứng di chuyển hoặc mất thì Part mất theo)
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = espPart
    weld.Part1 = egg
    weld.Parent = espPart
    
    table.insert(ESPParts, espPart)
    
    -- Tùy chọn: Thêm BillboardGui hiển thị chữ "EGG" ở trên
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "EggLabel"
    billboard.Size = UDim2.new(0, 100, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 6, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = espPart
    
    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.Text = "EGG"
    text.TextColor3 = Color3.fromRGB(255, 255, 0)
    text.TextScaled = true
    text.Font = Enum.Font.GothamBold
    text.Parent = billboard
end

local function EnableEggESP()
    -- Xóa cũ
    for _, v in pairs(Highlights) do if v and v.Parent then v:Destroy() end end
    for _, v in pairs(ESPParts) do if v and v.Parent then v:Destroy() end end
    Highlights = {}
    ESPParts = {}
    
    -- Quét tất cả MeshPart trong EggSpawners
    for _, obj in pairs(workspace.EggSpawners:GetDescendants()) do
        if obj:IsA("MeshPart") and (obj.Name:find("egg") or obj.Name:find("Egg") or obj.Name == "_eggSpawn") then
            CreateESPForEgg(obj)
        end
    end
    
    -- Tự động khi trứng mới spawn
    ESPConnection = workspace.EggSpawners.DescendantAdded:Connect(function(desc)
        task.wait(0.2)
        if desc:IsA("MeshPart") then
            CreateESPForEgg(desc)
        end
    end)
    
    OrionLib:MakeNotification({
        Name = "ESP Egg",
        Content = "Đã bật ESP + Khối Part gần tất cả trứng!",
        Image = "rbxassetid://4483345998",
        Time = 4
    })
end

local function DisableEggESP()
    if ESPConnection then
        ESPConnection:Disconnect()
        ESPConnection = nil
    end
    
    for _, v in pairs(Highlights) do if v and v.Parent then v:Destroy() end end
    for _, v in pairs(ESPParts) do if v and v.Parent then v:Destroy() end end
    Highlights = {}
    ESPParts = {}
end

