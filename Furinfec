local MAX_DISTANCE = 18
local COOLDOWN = 4
local TELEPORT_DISTANCE = 3

local OnCooldown = false

-- =========================
-- TÌM NGƯỜI KHÁC TEAM GẦN NHẤT
-- =========================

local function GetNearestEnemy()
    local Character = LocalPlayer.Character
    local Root = Character
        and Character:FindFirstChild("HumanoidRootPart")

    if not Root then
        return nil
    end

    local NearestTarget = nil
    local NearestDistance = MAX_DISTANCE

    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer
        and Player.Team ~= LocalPlayer.Team then

            local TargetCharacter = Player.Character

            local TargetRoot = TargetCharacter
                and TargetCharacter:FindFirstChild("HumanoidRootPart")

            local Humanoid = TargetCharacter
                and TargetCharacter:FindFirstChildOfClass("Humanoid")

            if TargetRoot
            and Humanoid
            and Humanoid.Health > 0 then

                local Distance = (
                    Root.Position - TargetRoot.Position
                ).Magnitude

                if Distance <= NearestDistance then
                    NearestDistance = Distance
                    NearestTarget = TargetRoot
                end
            end
        end
    end

    return NearestTarget
end

-- =========================
-- CLICK NÚT SKILL
-- =========================

Button.MouseButton1Click:Connect(function()
    if OnCooldown then
        return
    end

    local Character = LocalPlayer.Character
    local Root = Character
        and Character:FindFirstChild("HumanoidRootPart")

    if not Root then
        return
    end

    local TargetRoot = GetNearestEnemy()

    if not TargetRoot then
        Button.Text = "Không có\ntarget"

        task.wait(1)

        if not OnCooldown then
            Button.Text = "Đánh\nlén :)"
        end

        return
    end

    local Distance = (
        Root.Position - TargetRoot.Position
    ).Magnitude

    if Distance > MAX_DISTANCE then
        return
    end

    OnCooldown = true

    -- Teleport ra phía sau target
    Root.CFrame = TargetRoot.CFrame * CFrame.new(
        0,
        0,
        TELEPORT_DISTANCE
    )

    -- Cooldown 4 giây
    for i = COOLDOWN, 1, -1 do
        Button.Text = i .. "s"
        task.wait(1)
    end

    Button.Text = "Đánh\nlén :)"
    OnCooldown = false
end)

